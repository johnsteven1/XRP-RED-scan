<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#090a0d">
<title>XRP Sentinel</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/professional-moderate-ui.css">
</head>
<body>
<div class="mobile-app">
    <header class="mobile-header">
        <div>
            <h1 id="pageHeading">Dashboard</h1>
            <p id="pageSubheading">XRP transaction monitoring and verification</p>
        </div>
        <button class="header-refresh" type="button" onclick="refreshLogs(); loadAnalytics();" aria-label="Refresh">
            <span>↻</span>
        </button>
    </header>

    <main class="page-content">
        <!-- HOME -->
        <section class="app-page active" id="homePage" data-page="home">
            <div class="stats-grid" id="analyticsStats">
                <article class="stat-card">
                    <div class="stat-icon"><span>⌕</span></div>
                    <div><span class="stat-label">TOTAL SCANS</span><strong id="totalScans">0</strong></div>
                </article>
                <article class="stat-card">
                    <div class="stat-icon"><span>$</span></div>
                    <div><span class="stat-label">XRP AT RISK</span><strong id="totalXRP">0 XRP</strong></div>
                </article>
                <article class="stat-card">
                    <div class="stat-icon"><span>!</span></div>
                    <div><span class="stat-label">MISSING TAGS</span><strong id="totalMissing">0</strong></div>
                </article>
                <article class="stat-card">
                    <div class="stat-icon"><span>⌁</span></div>
                    <div><span class="stat-label">AVERAGE / SCAN</span><strong id="avgMissing">0.00</strong></div>
                </article>
            </div>

            <article class="panel overview-card">
                <div class="overview-head">
                    <div>
                        <h2>Scanner overview</h2>
                        <p>Blockchain-level XRP transaction verification</p>
                    </div>
                    <button class="open-scanner" type="button" onclick="showPage('scanner')">Open<br>Scanner</button>
                </div>
                <div class="verification-box">
                    <h3>VERIFICATION STATUS</h3>
                    <div class="verify-row"><span>Network</span><b>XRP Ledger</b></div>
                    <div class="verify-row"><span>Validation</span><b class="red-text">Blockchain verified</b></div>
                    <div class="verify-row"><span>Transaction type</span><b>Successful Payment</b></div>
                    <div class="verify-row"><span>Destination Tag</span><b>Required to be absent</b></div>
                    <div class="verify-row"><span>Memos</span><b>Required to be absent</b></div>
                </div>
            </article>
        </section>

        <!-- SCANNER -->
        <section class="app-page" id="scannerPage" data-page="scanner">
            <article class="panel scanner-card">
                <div class="scanner-head">
                    <div>
                        <h2>Wallet Scanner</h2>
                        <p>Search an XRP wallet for payments without routing information</p>
                    </div>
                    <strong class="verified-label">XRPL<br>VERIFIED</strong>
                </div>

                <div class="scanner-body">
                    <label class="field-label">XRP WALLET ADDRESS</label>
                    <div class="input-wrap">
                        <input type="text" id="walletAddress" value="rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh" placeholder="rXXXXXXXXXXXXXXXXXXXXXXXXX" autocomplete="off">
                        <button class="clear-input" type="button" onclick="document.getElementById('walletAddress').value=''">Clear</button>
                    </div>

                    <label class="field-label">TRANSACTION LIMIT</label>
                    <div class="select-wrap">
                        <select id="limit">
                            <option value="100">1,000</option>
                            <option value="500">500</option>
                            <option value="1000">1,000</option>
                        </select>
                    </div>

                    <label class="field-label">SCAN MODE</label>
                    <div class="select-wrap">
                        <select id="scanMode">
                            <option value="standard">Standard</option>
                            <option value="large">Large Scan (All)</option>
                        </select>
                    </div>

                    <div class="scan-actions">
                        <button class="scan-action start" id="scanBtn" type="button" onclick="scanWallet()">Start Scan</button>
                        <button class="scan-action pause" id="pauseBtn" type="button" onclick="pauseActiveScan()">Pause</button>
                        <button class="scan-action stop" id="stopBtn" type="button" onclick="stopActiveScan()">Stop</button>
                    </div>

                    <button class="large-scan-hidden" id="largeScanBtn" type="button" onclick="startLargeScan()">Large Scan (All)</button>

                    <div id="scanProgress" class="scan-progress" style="display:none;">
                        <div class="progress-header"><span class="progress-title">Scan in progress</span><span class="progress-percentage">0%</span></div>
                        <div class="progress-track"><div class="progress-bar"></div></div>
                        <div class="progress-stats"></div>
                        <div class="progress-status"></div>
                    </div>
                </div>
            </article>

            <article class="panel scanner-info">
                <div class="panel-title-row"><h2>Scanner information</h2><span class="info-dot">i</span></div>
                <div class="info-box">
                    <div><span>API</span><b id="apiStatus">Checking</b></div>
                    <div><span>Validation</span><b class="red-text">Blockchain verified</b></div>
                    <div><span>Payments</span><b>Successful only</b></div>
                    <div><span>Missing tags</span><b>Destination Tag + Memos absent</b></div>
                </div>
            </article>

            <div id="liveFilesPanel" class="panel live-files-panel" style="display:none;">
                <div class="panel-title-row"><h2>Live Scan</h2><span class="live-pill">LIVE</span></div>
                <div id="liveFilesList" class="live-files-list"><div class="empty-state">Waiting for scan...</div></div>
            </div>

            <div id="fileDownloadPanel" class="file-download-panel" style="display:none;"></div>
            <button id="explorerBtn" type="button" style="display:none;"></button>
        </section>

        <!-- RESULTS -->
        <section class="app-page" id="resultsPage" data-page="results">
            <div class="section-heading">
                <h2>Results</h2>
                <p>Verified transactions identified by the scanner</p>
            </div>

            <article class="panel results-panel" id="summarySection" style="display:none;">
                <div class="results-header">
                    <div>
                        <h2>Scan Results</h2>
                        <span class="result-badge" id="resultCount">0 found</span>
                    </div>
                    <div class="results-downloads">
                        <button class="round-btn" type="button" onclick="downloadData('csv')">↓</button>
                        <button class="round-btn" type="button" onclick="downloadData('json')">□</button>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="summary-stats" id="statsGrid"></div>
                    <div class="table-container">
                        <table>
                            <thead><tr>
                                <th>Date & Time</th><th>Transaction Hash</th><th>Sender</th><th>Amount (XRP)</th><th>Destination Tag</th><th>Validation Status</th><th>Actions</th>
                            </tr></thead>
                            <tbody id="tableBody"><tr><td colspan="7" class="empty-state">No data yet. Start a scan to see results.</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </article>

            <article class="panel results-empty" id="resultsEmpty">
                <div class="empty-icon">⌕</div>
                <h3>No scan results yet</h3>
                <p>Run a verified wallet scan and your results will appear here.</p>
                <button class="open-scanner" type="button" onclick="showPage('scanner')">Open Scanner</button>
            </article>
        </section>

        <!-- ACTIVITY -->
        <section class="app-page" id="activityPage" data-page="activity">
            <div class="section-heading">
                <h2>Activity</h2>
                <p>Recent scanner activity and verification events</p>
            </div>
            <article class="panel activity-card logs-panel">
                <div class="panel-title-row">
                    <h2>Activity Log</h2>
                    <button class="round-btn" type="button" onclick="refreshLogs()">↻</button>
                </div>
                <div class="panel-body">
                    <div class="logs-container" id="logsContainer"><div class="empty-state">No scan history available</div></div>
                </div>
            </article>
        </section>

        <!-- SETTINGS -->
        <section class="app-page" id="settingsPage" data-page="settings">
            <div class="section-heading">
                <h2>Settings</h2>
                <p>Scanner configuration and verification information</p>
            </div>
            <article class="panel settings-card">
                <div class="setting-row"><div><b>Network</b><span>XRP Ledger</span></div><strong class="red-text">Connected</strong></div>
                <div class="setting-row"><div><b>Verification</b><span>Blockchain-level validation</span></div><strong class="red-text">Enabled</strong></div>
                <div class="setting-row"><div><b>Transaction type</b><span>Successful Payment</span></div><strong>Required</strong></div>
                <div class="setting-row"><div><b>Destination Tag</b><span>Missing tag detection</span></div><strong>Required to be absent</strong></div>
                <div class="setting-row"><div><b>Memos</b><span>Memo validation</span></div><strong>Required to be absent</strong></div>
                <button class="settings-action" type="button" onclick="refreshLogs(); loadAnalytics(); showNotification('Scanner data refreshed','success')">Refresh scanner data</button>
            </article>
        </section>

        <!-- Hidden loading overlay retained for existing scanner logic -->
        <div id="loading" class="loading-overlay" style="display:none;">
            <div class="loading-content"><div class="loading-spinner"></div><p>Scanning wallet on XRP Ledger</p><span>Blockchain verification in progress</span></div>
        </div>

        <!-- Hidden compatibility containers for existing file/scan functions -->
        <div id="livePreviewModal" style="display:none;"><iframe id="livePreviewFrame"></iframe></div>
        <div id="fileExplorerModal" style="display:none;"></div>
    </main>

    <nav class="bottom-nav" aria-label="Main navigation">
        <button class="nav-button active" data-page="home" type="button" onclick="showPage('home')"><span class="nav-icon">⌘</span><span>Home</span></button>
        <button class="nav-button" data-page="scanner" type="button" onclick="showPage('scanner')"><span class="nav-icon">⌕</span><span>Scanner</span></button>
        <button class="nav-button" data-page="results" type="button" onclick="showPage('results')"><span class="nav-icon">☷</span><span>Results</span></button>
        <button class="nav-button" data-page="activity" type="button" onclick="showPage('activity')"><span class="nav-icon">⌁</span><span>Activity</span></button>
        <button class="nav-button" data-page="settings" type="button" onclick="showPage('settings')"><span class="nav-icon">☼</span><span>Settings</span></button>
    </nav>
</div>

<script src="js/app.js"></script>
<script>
(function(){
    const pageNames = {
        home: ['Dashboard','XRP transaction monitoring and verification'],
        scanner: ['Scanner','Blockchain-level XRP transaction verification'],
        results: ['Results','Verified XRP transactions and missing-tag findings'],
        activity: ['Activity','XRP transaction monitoring history'],
        settings: ['Settings','Scanner configuration and verification']
    };

    window.showPage = function(page) {
        document.querySelectorAll('.app-page').forEach(p => p.classList.toggle('active', p.dataset.page === page));
        document.querySelectorAll('.nav-button').forEach(b => b.classList.toggle('active', b.dataset.page === page));
        const name = pageNames[page] || pageNames.home;
        document.getElementById('pageHeading').textContent = name[0];
        document.getElementById('pageSubheading').textContent = name[1];
        window.scrollTo({top:0, behavior:'smooth'});

        if (page === 'results') {
            const hasResults = document.querySelectorAll('#tableBody tr').length > 0 &&
                !document.querySelector('#tableBody .empty-state');
            document.getElementById('resultsEmpty').style.display = hasResults ? 'none' : 'block';
            document.getElementById('summarySection').style.display = hasResults ? 'block' : document.getElementById('summarySection').style.display;
        }
    };

    window.pauseActiveScan = async function(){
        if (!window.activeScanId && typeof activeScanId !== 'undefined') window.activeScanId = activeScanId;
        const id = window.activeScanId || (typeof activeScanId !== 'undefined' ? activeScanId : null);
        if (!id) { showNotification('No large scan is currently running','warning'); return; }
        try {
            const r = await fetch(`${API_BASE}/scan/pause/${id}`, {method:'POST'});
            const d = await r.json();
            if (r.ok) showNotification('Scan paused','info'); else showNotification(d.error || 'Unable to pause scan','error');
        } catch(e) { showNotification('Network error: '+e.message,'error'); }
    };

    window.resumeActiveScan = async function(){
        const id = window.activeScanId || (typeof activeScanId !== 'undefined' ? activeScanId : null);
        if (!id) { showNotification('No paused scan found','warning'); return; }
        try {
            const r = await fetch(`${API_BASE}/scan/resume/${id}`, {method:'POST'});
            const d = await r.json();
            if (r.ok) { showNotification('Scan resumed','success'); if (typeof pollScanStatus === 'function') pollScanStatus(id); }
            else showNotification(d.error || 'Unable to resume scan','error');
        } catch(e) { showNotification('Network error: '+e.message,'error'); }
    };

    window.stopActiveScan = async function(){
        const id = window.activeScanId || (typeof activeScanId !== 'undefined' ? activeScanId : null);
        if (!id) { showNotification('No large scan is currently running','warning'); return; }
        try {
            const r = await fetch(`${API_BASE}/scan/stop/${id}`, {method:'POST'});
            const d = await r.json();
            if (r.ok) {
                if (typeof scanPollInterval !== 'undefined' && scanPollInterval) clearInterval(scanPollInterval);
                if (typeof liveFilesInterval !== 'undefined' && liveFilesInterval) clearInterval(liveFilesInterval);
                showNotification('Scan stopped and checkpoint preserved','info');
            } else showNotification(d.error || 'Unable to stop scan','error');
        } catch(e) { showNotification('Network error: '+e.message,'error'); }
    };

    document.addEventListener('DOMContentLoaded', () => {
        const address = document.getElementById('walletAddress');
        const apiStatus = document.getElementById('apiStatus');
        if (address) address.addEventListener('input', () => localStorage.setItem('xrp_sentinel_wallet_address', address.value));
        setTimeout(async () => {
            try {
                const r = await fetch(`${API_BASE}/test`);
                apiStatus.textContent = r.ok ? 'Connected' : 'Offline';
                apiStatus.className = r.ok ? 'red-text' : '';
            } catch(e) {
                apiStatus.textContent = 'Offline';
            }
        }, 400);

        // Keep result navigation useful after every standard scan.
        const originalDisplayResults = window.displayResults;
        if (originalDisplayResults) {
            window.displayResults = function(data) {
                originalDisplayResults(data);
                const empty = document.getElementById('resultsEmpty');
                if (empty) empty.style.display = 'none';
            };
        }
    });
})();
</script>
    <!-- Data Persistence: Auto-save & load Wallet Address, Scan Results (table data), Activity Logs -->
    <script>
        (function() {
            // --- LocalStorage Keys ---
            const STORAGE_KEYS = {
                WALLET_ADDRESS: 'xrp_sentinel_wallet_address',
                SCAN_RESULTS: 'xrp_sentinel_scan_results',   // array of transaction objects
                ACTIVITY_LOGS: 'xrp_sentinel_activity_logs'
            };

            // Helper: dispatch custom event when table/logs are updated externally (so we can save)
            function triggerDataSave() {
                // Save current wallet address from DOM
                const walletInput = document.getElementById('walletAddress');
                if (walletInput) {
                    const addr = walletInput.value.trim();
                    if (addr) localStorage.setItem(STORAGE_KEYS.WALLET_ADDRESS, addr);
                }
                
                // Save scan results (table data) by reading tbody rows
                const tableBody = document.getElementById('tableBody');
                if (tableBody && tableBody.children.length > 0) {
                    const rows = Array.from(tableBody.querySelectorAll('tr'));
                    // skip empty state row if it contains colspan empty message
                    const hasData = rows.some(row => !row.querySelector('.empty-state') && row.cells && row.cells.length > 1);
                    if (hasData) {
                        const results = [];
                        for (let row of rows) {
                            if (row.querySelector('.empty-state')) continue;
                            const cells = row.cells;
                            if (cells.length >= 6) {
                                results.push({
                                    date: cells[0]?.innerText || '',
                                    txHash: cells[1]?.innerText || '',
                                    sender: cells[2]?.innerText || '',
                                    amount: cells[3]?.innerText || '',
                                    destinationTag: cells[4]?.innerText || '',
                                    validationStatus: cells[5]?.innerHTML || cells[5]?.innerText || ''
                                });
                            }
                        }
                        if (results.length) localStorage.setItem(STORAGE_KEYS.SCAN_RESULTS, JSON.stringify(results));
                        else localStorage.removeItem(STORAGE_KEYS.SCAN_RESULTS);
                    } else {
                        // If no data, clear stored results
                        localStorage.removeItem(STORAGE_KEYS.SCAN_RESULTS);
                    }
                } else {
                    localStorage.removeItem(STORAGE_KEYS.SCAN_RESULTS);
                }
                
                // Save activity logs
                const logsContainer = document.getElementById('logsContainer');
                if (logsContainer) {
                    const logEntries = [];
                    const logItems = logsContainer.querySelectorAll('.log-entry');
                    if (logItems.length) {
                        logItems.forEach(item => {
                            const text = item.innerText.trim();
                            if (text) logEntries.push(text);
                        });
                        if (logEntries.length) localStorage.setItem(STORAGE_KEYS.ACTIVITY_LOGS, JSON.stringify(logEntries));
                        else localStorage.removeItem(STORAGE_KEYS.ACTIVITY_LOGS);
                    } else {
                        // check if empty-state text exists but we don't save empty
                        const emptyMsg = logsContainer.querySelector('.empty-state');
                        if (!emptyMsg && logEntries.length === 0) localStorage.removeItem(STORAGE_KEYS.ACTIVITY_LOGS);
                        else if (logEntries.length) localStorage.setItem(STORAGE_KEYS.ACTIVITY_LOGS, JSON.stringify(logEntries));
                        else localStorage.removeItem(STORAGE_KEYS.ACTIVITY_LOGS);
                    }
                }
            }

            // Load wallet address, scan results, activity logs and restore UI
            function loadSavedData() {
                // 1. Restore Wallet Address
                const savedWallet = localStorage.getItem(STORAGE_KEYS.WALLET_ADDRESS);
                const walletInput = document.getElementById('walletAddress');
                if (savedWallet && walletInput) {
                    walletInput.value = savedWallet;
                }
                
                // 2. Restore Scan Results (table)
                const savedResults = localStorage.getItem(STORAGE_KEYS.SCAN_RESULTS);
                const tableBody = document.getElementById('tableBody');
                const summarySection = document.getElementById('summarySection');
                if (savedResults && tableBody) {
                    try {
                        const results = JSON.parse(savedResults);
                        if (Array.isArray(results) && results.length > 0) {
                            renderTableFromData(results);
                            if (summarySection) summarySection.style.display = 'block';
                            // also attempt to update stats and counters if global functions exist (defer to app.js)
                            if (typeof updateStatsFromData === 'function') updateStatsFromData(results);
                            else if (window.updateAnalyticsFromResults) window.updateAnalyticsFromResults(results);
                            // update result count badge
                            const resultCountSpan = document.getElementById('resultCount');
                            if (resultCountSpan) resultCountSpan.innerText = `${results.length} found`;
                        } else {
                            if (summarySection) summarySection.style.display = 'none';
                            if (tableBody) tableBody.innerHTML = '<tr><td colspan="7" class="empty-state">No data yet. Start a scan to see results.</td></tr>';
                        }
                    } catch(e) { console.warn("Error parsing saved scan results", e); }
                } else if (tableBody && (!savedResults || savedResults === '[]')) {
                    if (summarySection) summarySection.style.display = 'none';
                    tableBody.innerHTML = '<tr><td colspan="7" class="empty-state">No data yet. Start a scan to see results.</td></tr>';
                }
                
                // 3. Restore Activity Logs
                const savedLogs = localStorage.getItem(STORAGE_KEYS.ACTIVITY_LOGS);
                const logsContainer = document.getElementById('logsContainer');
                if (savedLogs && logsContainer) {
                    try {
                        const logs = JSON.parse(savedLogs);
                        if (Array.isArray(logs) && logs.length > 0) {
                            logsContainer.innerHTML = '';
                            logs.forEach(logText => {
                                const logDiv = document.createElement('div');
                                logDiv.className = 'log-entry';
                                logDiv.style.cssText = 'padding: 8px 12px; border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 13px; font-family: monospace; color: #e2e8f0;';
                                logDiv.innerText = logText;
                                logsContainer.appendChild(logDiv);
                            });
                        } else {
                            logsContainer.innerHTML = '<div class="empty-state">No scan history available</div>';
                        }
                    } catch(e) { console.warn("Error parsing saved logs", e); }
                } else if (logsContainer && (!savedLogs || savedLogs === '[]')) {
                    logsContainer.innerHTML = '<div class="empty-state">No scan history available</div>';
                }
                
                // trigger any extra UI updates (like total scans, XRP amount) after load
                if (typeof window.updateDashboardStats === 'function') {
                    window.updateDashboardStats();
                } else {
                    // fallback: attempt to recompute from table data
                    const rows = document.querySelectorAll('#tableBody tr');
                    let missingCount = 0;
                    let totalXrp = 0;
                    rows.forEach(row => {
                        if (row.querySelector('.empty-state')) return;
                        const cells = row.cells;
                        if (cells.length >= 4) {
                            const amountText = cells[3]?.innerText || '0';
                            const amount = parseFloat(amountText) || 0;
                            totalXrp += amount;
                            const tagText = cells[4]?.innerText || '';
                            if (tagText === 'Missing' || tagText === 'None' || tagText === '') missingCount++;
                        }
                    });
                    const totalScansElem = document.getElementById('totalScans');
                    const totalXRPElem = document.getElementById('totalXRP');
                    const totalMissingElem = document.getElementById('totalMissing');
                    const avgMissingElem = document.getElementById('avgMissing');
                    const rowCount = rows.length - (rows[0]?.querySelector('.empty-state') ? 1 : 0);
                    if (totalScansElem) totalScansElem.innerText = rowCount > 0 ? rowCount : '-';
                    if (totalXRPElem) totalXRPElem.innerText = totalXrp > 0 ? `${totalXrp.toFixed(2)} XRP` : '-';
                    if (totalMissingElem) totalMissingElem.innerText = missingCount > 0 ? missingCount : '-';
                    if (avgMissingElem && rowCount > 0) avgMissingElem.innerText = (missingCount / rowCount).toFixed(1);
                    else if (avgMissingElem) avgMissingElem.innerText = '-';
                }
            }
            
            // Helper to render table data (ensures consistency)
            function renderTableFromData(dataArray) {
                const tableBody = document.getElementById('tableBody');
                if (!tableBody) return;
                if (!dataArray || dataArray.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="7" class="empty-state">No data yet. Start a scan to see results.</td></tr>';
                    return;
                }
                tableBody.innerHTML = '';
                dataArray.forEach(tx => {
                    const row = tableBody.insertRow();
                    row.insertCell(0).innerText = tx.date || '';
                    row.insertCell(1).innerText = tx.txHash || '';
                    row.insertCell(2).innerText = tx.sender || '';
                    row.insertCell(3).innerText = tx.amount || '';
                    row.insertCell(4).innerText = tx.destinationTag || '';
                    row.insertCell(5).innerHTML = tx.validationStatus || '<span style="color:#10b981;">✓ Verified</span>';
                    const actionCell = row.insertCell(6);
                    const viewBtn = document.createElement('button');
                    viewBtn.innerText = 'Details';
                    viewBtn.className = 'btn btn-icon';
                    viewBtn.style.background = 'none';
                    viewBtn.style.border = 'none';
                    viewBtn.style.color = '#00E5BF';
                    viewBtn.style.cursor = 'pointer';
                    viewBtn.onclick = (function(hash) { return function() { alert(`Transaction details:\nHash: ${hash}\nBlockchain verified.`); }; })(tx.txHash);
                    actionCell.appendChild(viewBtn);
                });
            }
            
            // Override / observe changes to save data whenever critical updates happen
            // We'll wrap any existing functions that mutate table or logs. But to be safe, we use MutationObserver and event delegation.
            // Also attach event listeners to input and any scan completion.
            function setupAutoSaveObservers() {
                // Save on wallet address change
                const walletInput = document.getElementById('walletAddress');
                if (walletInput) {
                    walletInput.addEventListener('input', () => {
                        const addr = walletInput.value.trim();
                        if (addr) localStorage.setItem(STORAGE_KEYS.WALLET_ADDRESS, addr);
                        else localStorage.removeItem(STORAGE_KEYS.WALLET_ADDRESS);
                    });
                }
                
                // Watch for changes in tableBody (scan results)
                const tableBody = document.getElementById('tableBody');
                if (tableBody) {
                    const observer = new MutationObserver(() => { triggerDataSave(); });
                    observer.observe(tableBody, { childList: true, subtree: true, characterData: true });
                }
                
                // Watch activity logs container
                const logsContainer = document.getElementById('logsContainer');
                if (logsContainer) {
                    const logObserver = new MutationObserver(() => { triggerDataSave(); });
                    logObserver.observe(logsContainer, { childList: true, subtree: true, characterData: true });
                }
                
                // also hook into global functions if available (app.js often adds logs/results)
                // Ensure saving before unload
                window.addEventListener('beforeunload', () => { triggerDataSave(); });
                // periodic auto-save also helpful
                setInterval(() => { triggerDataSave(); }, 3000);
            }
            
            // Expose a method that can be called by existing code after scan completes to ensure save
            window.persistCurrentData = function() {
                triggerDataSave();
            };
            
            // Patch potential calls inside app.js: we can detect if scanWallet or startLargeScan exist later,
            // but we will also add an after-scan hook via setTimeout to watch for changes
            // Safe: after each possible scan action, we auto-save because observer catches DOM changes anyway.
            
            // Extend downloadData and any other to trigger save before download (optional)
            const originalDownload = window.downloadData;
            if (originalDownload) {
                window.downloadData = function(type) {
                    triggerDataSave();
                    originalDownload(type);
                };
            }
            
            // Function to force sync from current dom to localStorage
            window.forceSaveToLocalStorage = triggerDataSave;
            
            // initial load
            loadSavedData();
            setupAutoSaveObservers();
            // initial save after load to make sure everything consistent
            setTimeout(() => { triggerDataSave(); }, 500);
        })();
    </script>
</body>
</html>
